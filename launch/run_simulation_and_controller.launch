<launch>
  <!-- Start the hero Gazebo simulation from rm_description_for_task. -->
  <arg name="paused" default="false"/>
  <arg name="roller_type" default="simple" doc="simple or realistic"/>

  <include file="$(find rm_description_for_task)/launch/hero.launch">
    <arg name="load_chassis" value="true"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="roller_type" value="$(arg roller_type)"/>
  </include>

  <!-- Load and spawn our controller into the running controller_manager. -->
  <rosparam file="$(find hero_chassis_controller)/config/controllers.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" args="hero_chassis_controller"/>
</launch>
